{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "../pipeline/sr/schema/**/*.json"
  ]
}
